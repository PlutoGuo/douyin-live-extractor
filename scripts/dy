#!/bin/bash

# 抖音直播流提取器 - 主启动脚本
# DouyinY Live Stream Extractor - Main Launcher
# 使用方法: ./dy 或 dy (如果已配置PATH)

# ===== 环境变量配置 =====
export DY_PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DY_APP_NAME="抖音直播流提取器"
export DY_VERSION="2.0"
export DY_SAVE_DIR="$HOME/Documents/直播源/抖音直播源"
export DY_CONFIG_FILE="$DY_PROJECT_DIR/src/config.py"
export DY_TEMP_DIR="$DY_PROJECT_DIR/temp"
export DY_LOGS_DIR="$DY_PROJECT_DIR/logs"

# 颜色定义
export DY_COLOR_RED='\033[0;31m'
export DY_COLOR_GREEN='\033[0;32m'
export DY_COLOR_YELLOW='\033[1;33m'
export DY_COLOR_BLUE='\033[0;34m'
export DY_COLOR_PURPLE='\033[0;35m'
export DY_COLOR_CYAN='\033[0;36m'
export DY_COLOR_NC='\033[0m'

# 日志函数
dy_log() {
    echo -e "${DY_COLOR_CYAN}[$(date '+%H:%M:%S')]${DY_COLOR_NC} $1"
}

dy_success() {
    echo -e "${DY_COLOR_GREEN}[✓]${DY_COLOR_NC} $1"
}

dy_error() {
    echo -e "${DY_COLOR_RED}[✗]${DY_COLOR_NC} $1"
}

dy_warning() {
    echo -e "${DY_COLOR_YELLOW}[!]${DY_COLOR_NC} $1"
}

# 显示横幅
dy_banner() {
    clear
    echo -e "${DY_COLOR_PURPLE}"
    echo "┌─────────────────────────────────────┐"
    echo "│       抖音直播流提取器 v${DY_VERSION}        │"
    echo "│    DouyinY Live Stream Extractor    │"
    echo "└─────────────────────────────────────┘"
    echo -e "${DY_COLOR_NC}"
}

# 检查Python环境
check_python() {
    if command -v python3 &> /dev/null; then
        export DY_PYTHON_CMD="python3"
    elif command -v python &> /dev/null; then
        export DY_PYTHON_CMD="python"
    else
        dy_error "未找到Python环境，请安装Python 3.7+"
        exit 1
    fi
    
    dy_success "Python环境: $($DY_PYTHON_CMD --version)"
}

# 快速检查
quick_check() {
    dy_log "正在启动 $DY_APP_NAME..."
    
    # 检查Python
    check_python
    
    # 检查主程序
    if [ ! -f "$DY_PROJECT_DIR/src/main.py" ]; then
        dy_error "未找到主程序文件 src/main.py"
        exit 1
    fi
    
    # 创建必要目录
    mkdir -p "$DY_SAVE_DIR" "$DY_TEMP_DIR" "$DY_LOGS_DIR" 2>/dev/null
    
    dy_success "环境检查完成"
}

# 启动程序
start_app() {
    cd "$DY_PROJECT_DIR"
    
    dy_log "启动应用程序..."
    echo ""
    
    # 启动主程序，将日志保存到文件
    $DY_PYTHON_CMD src/main.py 2>&1 | tee "$DY_LOGS_DIR/dy_$(date +%Y%m%d).log"
    
    local exit_code=$?
    echo ""
    
    if [ $exit_code -eq 0 ]; then
        dy_success "程序正常退出"
    else
        dy_error "程序异常退出 (退出码: $exit_code)"
    fi
}

# 显示帮助信息
show_help() {
    echo "用法: dy [选项]"
    echo ""
    echo "选项:"
    echo "  无参数    - 启动程序"
    echo "  -h, --help - 显示此帮助信息"
    echo "  -v, --version - 显示版本信息"
    echo "  -c, --check - 只运行环境检查"
    echo ""
    echo "其他脚本:"
    echo "  dyfast    - 快速启动（无检查）"
    echo "  dydev     - 开发模式"
    echo "  dyconfig  - 配置向导"
    echo ""
    echo "环境变量:"
    echo "  DY_PROJECT_DIR - 项目目录"
    echo "  DY_SAVE_DIR    - 文件保存目录"
    echo "  DY_PYTHON_CMD  - Python命令"
}

# 处理命令行参数
case "${1:-}" in
    -h|--help)
        dy_banner
        show_help
        exit 0
        ;;
    -v|--version)
        echo "$DY_APP_NAME v$DY_VERSION"
        exit 0
        ;;
    -c|--check)
        dy_banner
        quick_check
        dy_success "所有检查通过"
        exit 0
        ;;
    "")
        # 默认启动
        dy_banner
        quick_check
        start_app
        ;;
    *)
        echo "未知选项: $1"
        echo "使用 'dy --help' 查看帮助"
        exit 1
        ;;
esac
