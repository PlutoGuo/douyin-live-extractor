#!/bin/bash

# 抖音直播流提取器 - 开发模式脚本
# DouyinY Live Stream Extractor - Development Mode
# 使用方法: ./dydev 或 dydev

# 导入主脚本环境变量
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/dy" ]; then
    source "$SCRIPT_DIR/dy" 2>/dev/null || true
fi

# 开发模式特定环境变量
export DY_DEV_MODE=true
export DY_DEBUG=true
export DY_VERBOSE=true

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m'

# 开发模式横幅
dev_banner() {
    clear
    echo -e "${CYAN}"
    echo "┌─────────────────────────────────────┐"
    echo "│         🛠️  开发者模式 🛠️          │"
    echo "│    DouyinY Live Stream Extractor    │"
    echo "│         Development Mode            │"
    echo "└─────────────────────────────────────┘"
    echo -e "${NC}"
}

# 开发模式信息
dev_info() {
    echo -e "${YELLOW}🔧 开发模式功能:${NC}"
    echo "  • 详细调试信息"
    echo "  • 文件变更监控"
    echo "  • 错误堆栈跟踪"
    echo "  • 性能分析"
    echo "  • 热重载支持"
    echo ""
}

# 检查开发工具
check_dev_tools() {
    echo -e "${CYAN}检查开发工具...${NC}"
    
    # 检查git
    if command -v git &> /dev/null; then
        echo -e "${GREEN}✓ Git: $(git --version)${NC}"
        
        # 显示git状态
        if [ -d "$DY_PROJECT_DIR/.git" ]; then
            cd "$DY_PROJECT_DIR"
            echo -e "${BLUE}Git状态:${NC}"
            git status --porcelain | head -5
            echo ""
        fi
    else
        echo -e "${YELLOW}⚠ Git未安装${NC}"
    fi
    
    # 检查代码编辑器
    if command -v code &> /dev/null; then
        echo -e "${GREEN}✓ VS Code已安装${NC}"
    elif command -v vim &> /dev/null; then
        echo -e "${GREEN}✓ Vim已安装${NC}"
    else
        echo -e "${YELLOW}⚠ 未找到常用代码编辑器${NC}"
    fi
}

# 显示项目结构
show_project_structure() {
    echo -e "${CYAN}📁 项目结构:${NC}"
    cd "$DY_PROJECT_DIR"
    
    if command -v tree &> /dev/null; then
        tree -I '__pycache__|*.pyc|.git' -L 2
    else
        echo "项目目录: $DY_PROJECT_DIR"
        ls -la | grep -E "^d|\.py$|\.sh$" | head -10
    fi
    echo ""
}

# 运行测试
run_tests() {
    echo -e "${CYAN}🧪 运行测试...${NC}"
    cd "$DY_PROJECT_DIR"
    
    # 语法检查
    echo "检查Python语法..."
    find src -name "*.py" -exec python3 -m py_compile {} \; 2>/dev/null
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✓ 语法检查通过${NC}"
    else
        echo -e "${RED}✗ 语法检查失败${NC}"
    fi
    
    # 导入测试
    echo "测试模块导入..."
    python3 -c "
import sys
sys.path.append('src')
try:
    import main, parser, network, config
    print('✓ 核心模块导入成功')
except ImportError as e:
    print(f'✗ 模块导入失败: {e}')
" 2>/dev/null
    
    echo ""
}

# 开发模式菜单
dev_menu() {
    while true; do
        echo -e "${PURPLE}🛠️  开发选项:${NC}"
        echo "  1. 🚀 启动程序 (调试模式)"
        echo "  2. 🧪 运行测试"
        echo "  3. 📊 性能分析"
        echo "  4. 📁 查看项目结构"
        echo "  5. 📝 查看日志文件"
        echo "  6. 🔧 打开配置文件"
        echo "  7. 🌐 检查网络连接"
        echo "  8. 🚪 退出开发模式"
        echo ""
        
        read -p "请选择操作 (1-8): " choice
        
        case $choice in
            1)
                start_debug_mode
                break
                ;;
            2)
                run_tests
                ;;
            3)
                echo -e "${CYAN}📊 性能分析功能开发中...${NC}"
                ;;
            4)
                show_project_structure
                ;;
            5)
                if [ -d "$DY_LOGS_DIR" ] && [ "$(ls -A $DY_LOGS_DIR 2>/dev/null)" ]; then
                    echo -e "${CYAN}📝 最新日志文件:${NC}"
                    ls -lt "$DY_LOGS_DIR" | head -5
                    echo ""
                    read -p "查看最新日志? (y/n): " view_log
                    if [[ $view_log =~ ^[Yy] ]]; then
                        latest_log=$(ls -t "$DY_LOGS_DIR"/*.log 2>/dev/null | head -1)
                        if [ -n "$latest_log" ]; then
                            echo "查看: $latest_log"
                            tail -n 50 "$latest_log"
                        fi
                    fi
                else
                    echo -e "${YELLOW}📝 暂无日志文件${NC}"
                fi
                ;;
            6)
                if [ -f "$DY_CONFIG_FILE" ]; then
                    if command -v code &> /dev/null; then
                        code "$DY_CONFIG_FILE"
                    else
                        echo "配置文件: $DY_CONFIG_FILE"
                        head -20 "$DY_CONFIG_FILE"
                    fi
                fi
                ;;
            7)
                echo -e "${CYAN}🌐 检查网络连接...${NC}"
                ping -c 3 www.douyin.com &> /dev/null && echo -e "${GREEN}✓ 网络连接正常${NC}" || echo -e "${RED}✗ 网络连接失败${NC}"
                ;;
            8)
                echo -e "${GREEN}👋 退出开发模式${NC}"
                exit 0
                ;;
            *)
                echo -e "${RED}❌ 无效选择${NC}"
                ;;
        esac
        
        echo ""
        read -p "按回车键继续..."
        echo ""
    done
}

# 调试模式启动
start_debug_mode() {
    echo -e "${CYAN}🐛 启动调试模式...${NC}"
    cd "$DY_PROJECT_DIR"
    
    # 设置调试环境变量
    export PYTHONPATH="$DY_PROJECT_DIR/src:$PYTHONPATH"
    export DY_DEBUG_MODE=1
    
    # 启动程序并捕获输出
    echo -e "${GREEN}启动程序 (调试模式)...${NC}"
    echo "项目目录: $DY_PROJECT_DIR"
    echo "Python版本: $(python3 --version)"
    echo "调试模式: 开启"
    echo ""
    
    python3 -u src/main.py 2>&1 | tee "$DY_LOGS_DIR/debug_$(date +%Y%m%d_%H%M%S).log"
}

# 主函数
main() {
    dev_banner
    
    # 设置基本环境变量（如果未设置）
    if [ -z "$DY_PROJECT_DIR" ]; then
        export DY_PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
        export DY_LOGS_DIR="$DY_PROJECT_DIR/logs"
        mkdir -p "$DY_LOGS_DIR"
    fi
    
    dev_info
    check_dev_tools
    
    # 检查Python
    if command -v python3 &> /dev/null; then
        echo -e "${GREEN}✓ Python3: $(python3 --version)${NC}"
    else
        echo -e "${RED}✗ Python3未安装${NC}"
        exit 1
    fi
    
    echo ""
    dev_menu
}

# 执行主函数
main "$@"
